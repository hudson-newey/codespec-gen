{
  "name": "vite-plugin",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "plugin/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir plugin build && node -e \"const fs=require('node:fs');const src='plugin/dist';const dst='dist/vite-plugin';fs.rmSync(dst,{recursive:true,force:true});fs.mkdirSync(dst,{recursive:true});fs.cpSync(src,dst,{recursive:true});\""
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir plugin dev"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir plugin lint"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir plugin test"
      }
    }
  }
}
