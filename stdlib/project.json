{
  "name": "stdlib",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "stdlib/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "options": {
        "outputPath": "dist/stdlib",
        "tsConfig": "stdlib/tsconfig.json",
        "configFile": "stdlib/vite.config.ts"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir stdlib dev"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["stdlib/**/*.{ts,tsx,js,mjs,cjs}"],
        "eslintConfig": "eslint.config.cjs"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir stdlib test"
      }
    }
  }
}
