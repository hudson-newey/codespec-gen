{
  "name": "stdlib",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "stdlib/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir stdlib build && node -e \"const fs=require('node:fs');const src='stdlib/dist';const dst='dist/stdlib';fs.rmSync(dst,{recursive:true,force:true});fs.mkdirSync(dst,{recursive:true});fs.cpSync(src,dst,{recursive:true});\""
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir stdlib dev"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir stdlib lint"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir stdlib test"
      }
    }
  }
}
