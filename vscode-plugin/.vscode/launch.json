{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run CodeSpec Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode-plugin"
      ],
      "outFiles": [
        "${workspaceFolder}/vscode-plugin/dist/**/*.js"
      ],
      "preLaunchTask": "vscode-plugin:build"
    }
  ]
}
