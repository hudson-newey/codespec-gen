{
  "name": "@codespec/vscode-plugin",
  "displayName": "CodeSpec",
  "description": "CodeSpec VS Code extension — expand, preview, and inline LLM-generated code blocks",
  "version": "0.1.0",
  "private": true,
  "publisher": "codespec",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codespec.expand",
        "title": "CodeSpec: Expand block"
      },
      {
        "command": "codespec.inline",
        "title": "CodeSpec: Inline generated code"
      },
      {
        "command": "codespec.copy",
        "title": "CodeSpec: Copy generated code"
      },
      {
        "command": "codespec.regenerate",
        "title": "CodeSpec: Regenerate (rebuild)"
      }
    ],
    "chatParticipants": [
      {
        "id": "codespec.create",
        "name": "codespec",
        "fullName": "CodeSpec",
        "description": "Create and manage .codespec.md files",
        "isSticky": false,
        "commands": [
          {
            "name": "create",
            "description": "Create a new .codespec.md file from guided inputs"
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs && tsc -p ./tsconfig.json --noEmit",
    "watch": "node esbuild.config.mjs --watch",
    "lint": "echo \"No lint configured yet\"",
    "test": "echo \"No tests yet\""
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "add": "^2.0.6",
    "esbuild": "^0.28.0",
    "quick-lru": "^7.3.0",
    "typescript": "^5.9.2",
    "vscode-plugin": "^1.0.5"
  },
  "dependencies": {
    "@codespec/shared": "workspace:*"
  }
}
