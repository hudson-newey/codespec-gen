{
  "name": "@codespec/vscode-plugin",
  "displayName": "CodeSpec",
  "description": "CodeSpec VS Code extension scaffold",
  "version": "0.1.0",
  "private": true,
  "publisher": "codespec",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:codespec.hello"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codespec.hello",
        "title": "CodeSpec: Hello"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p ./tsconfig.json",
    "watch": "tsc -w -p ./tsconfig.json",
    "lint": "echo \"No lint configured yet\"",
    "test": "echo \"No tests yet\""
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "add": "^2.0.6",
    "quick-lru": "^7.3.0",
    "typescript": "^5.9.2",
    "vscode-plugin": "^1.0.5"
  },
  "dependencies": {
    "@codespec/shared": "workspace:*"
  }
}