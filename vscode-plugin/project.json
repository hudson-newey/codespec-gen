{
  "name": "vscode-plugin",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "vscode-plugin/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir vscode-plugin build"
      }
    },
    "watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir vscode-plugin watch"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir vscode-plugin lint"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir vscode-plugin test"
      }
    }
  }
}
