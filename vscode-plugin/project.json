{
  "name": "vscode-plugin",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "vscode-plugin/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir vscode-plugin build && node -e \"const fs=require('node:fs');const src='vscode-plugin/dist';const dst='dist/vscode-plugin';fs.rmSync(dst,{recursive:true,force:true});fs.mkdirSync(dst,{recursive:true});fs.cpSync(src,dst,{recursive:true});\""
      }
    },
    "watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir vscode-plugin watch"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir vscode-plugin lint"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir vscode-plugin test"
      }
    }
  }
}
