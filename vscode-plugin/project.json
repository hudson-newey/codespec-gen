{
  "name": "vscode-plugin",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "vscode-plugin/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "options": {
        "outputPath": "dist/vscode-plugin",
        "tsConfig": "vscode-plugin/tsconfig.json",
        "configFile": "vscode-plugin/vite.config.ts",
        "skipTypeCheck": true
      }
    },
    "watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir vscode-plugin watch"
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir vscode-plugin package"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["vscode-plugin/**/*.{ts,tsx,js,mjs,cjs}"],
        "eslintConfig": "eslint.config.cjs"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir vscode-plugin test"
      }
    }
  }
}
