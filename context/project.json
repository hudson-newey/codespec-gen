{
  "name": "context",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "context/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir context build"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir context dev"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["context/**/*.{ts,tsx,js,mjs,cjs}"],
        "eslintConfig": "eslint.config.cjs"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir context test"
      }
    }
  }
}
